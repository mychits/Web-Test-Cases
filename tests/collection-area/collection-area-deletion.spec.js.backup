test('Delete collection area by code', async ({ page }) => {
  test.setTimeout(180000);
  page.setDefaultTimeout(15000);

  const areaCode = 'MCF-CO-AR-8';

  console.log('[Target Code]', areaCode);

  // STEP 1: Login
  await loginIfNeeded(page);

  // STEP 2: Close Groups Closing Soon popup
  await closeClosingGroupsPopup(page);

  // STEP 3: Open Collection Area page
  await openCollectionArea(page);

  // STEP 4: Search using Collection Area Code
  const { row, areaName } = await findCollectionArea(
    page,
    areaCode
  );

  console.log('[Found] Collection Area:', areaName);

  // Safety: confirm the selected record is intended.
  // Set EXPECTED_DELETE_COLLECTION_AREA_NAME in .env.
  const expectedName = (
    process.env.EXPECTED_DELETE_COLLECTION_AREA_NAME || ''
  ).trim();

  if (!expectedName) {
    throw new Error(
      'Set EXPECTED_DELETE_COLLECTION_AREA_NAME in .env ' +
      'to confirm which Collection Area should be deleted.'
    );
  }

  if (areaName !== expectedName) {
    throw new Error(
      `Name mismatch. Expected "${expectedName}", ` +
      `but found "${areaName}". Deletion cancelled.`
    );
  }

  // STEP 5: Click three dots and select Delete
  await openActionMenu(row, page);

  // STEP 6: Enter Collection Area Name and delete
  await confirmDeletion(page, areaName);

  // STEP 7: Verify record is no longer displayed
  const main = page.locator('#app-main-scroll');

  const searchInput = main.locator(
    'input[placeholder^="Search" i]:visible'
  ).first();

  await searchInput.fill('');
  await searchInput.fill(areaCode);

  const matchingRows = main.locator(
    'table tbody tr'
  ).filter({
    has: page.locator('td:nth-child(2)').getByText(
      areaCode,
      { exact: true }
    )
  });

  await expect(matchingRows).toHaveCount(0, {
    timeout: 20000
  });

  console.log(
    '[Completed] Collection Area no longer listed:',
    areaCode,
    '| Name:',
    areaName
  );
});
  console.log('[Target]', AREA_NAME);

  // STEP 1: Login once.
  await loginIfNeeded(page);

  // STEP 2: Dismiss Closing Groups popup.
  await closeClosingGroupsPopup(page);

  // STEP 3: Open Collection Area page.
  await openCollectionArea(page);

  // STEP 4: Search using Collection Area page
  // Search... field (not Filter Employee).
  const { row, areaName } = await findCollectionArea(
    page,
    AREA_CODE
  );

  // STEP 5: Click row's three dots and Delete.
  await openActionMenu(row, page);

  // STEP 6: Enter exact name and confirm.
  const AREA_CODE = (
  process.env.DELETE_COLLECTION_AREA_CODE || ''
   ).trim();

  // STEP 7: Verify deletion.
  // Re-enter the search to confirm the table
  // no longer contains the target record.
  const main = page.locator('#app-main-scroll');

  const searchInput = main.locator(
    'input[placeholder^="Search" i]:visible'
  ).first();

  await expect(searchInput).toBeVisible();

  await searchInput.fill('');

  await searchInput.fill(AREA_NAME);

  const matchingRows = main.locator(
    'table tbody tr'
  ).filter({
    has: page.locator('td:nth-child(3)').getByText(
      AREA_NAME,
      { exact: true }
    )
  });

  await expect(matchingRows).toHaveCount(0, {
    timeout: 20000
