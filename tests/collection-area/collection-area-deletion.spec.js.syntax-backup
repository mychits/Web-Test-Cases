  await expect(row).toHaveCount(1, {
    timeout: 15000
  });

  await row.scrollIntoViewIfNeeded();

  const actionCell = row.locator('td').last();

  await expect(actionCell).toBeVisible({
    timeout: 15000
  });

  const threeDots = actionCell.locator(
    'button, [role="button"], [aria-haspopup]'
  ).first();

  if (await threeDots.count() > 0) {
    await threeDots.click();
  } else {
    const icon = actionCell.locator('svg').first();

    if (await icon.count() > 0) {
      await icon.click();
    } else {
      await actionCell.click();
    }
  }

  console.log('[Action] Three dots clicked');

  const menuDelete = page.getByRole('menuitem', {
    name: /^delete$/i
  }).first();

  const textDelete = page.getByText('Delete', {
    exact: true
  }).last();

  if (await menuDelete.isVisible().catch(() => false)) {
    await menuDelete.click();
  } else {
    await expect(textDelete).toBeVisible({
      timeout: 10000
    });

    await textDelete.click();
  }

  console.log('[Action] Delete option clicked');
}

// Find Delete in the opened menu.
  const menuDelete = page.getByRole('menuitem', {
    name: /^delete$/i
  }).first();

  if (await menuDelete.isVisible().catch(() => false)) {
    await menuDelete.click();
  } else {
    const deleteText = page.getByText(
      'Delete',
      { exact: true }
    ).last();

    await expect(deleteText).toBeVisible({
      timeout: 10000
    });

    await deleteText.click();
}

  console.log('[Action] Delete option clicked');
 
// ========================================
// DELETE CONFIRMATION
// ========================================

async function confirmDeletion(page, name) {
  console.log('[Delete] Waiting for confirmation popup');

  const dialog = page.locator(
    '[role="dialog"]:visible, ' +
    '[role="alertdialog"]:visible, ' +
    '.ant-modal:visible'
  ).last();

  // Some custom modals use a fixed overlay.
  const fallback = page.locator(
    'div.fixed.inset-0:visible'
  ).filter({
    has: page.getByRole('button', {
      name: /^delete$/i
    })
  }).last();

  let modal;

  if (await dialog.isVisible().catch(() => false)) {
    modal = dialog;
  } else {
    await expect(fallback).toBeVisible({
      timeout: 15000
    });

    modal = fallback;
  }

  console.log('[Delete] Confirmation popup opened');

  // The confirmation popup should have one text
  // input for typing the Collection Area name.
  const input = modal.locator(
    'input[type="text"]:visible, ' +
    'input:not([type]):visible'
  );

  await expect(input).toHaveCount(1, {
    timeout: 10000
  });

  await input.fill(name);

  await expect(input).toHaveValue(name);

  console.log('[Delete] Exact Collection Area name entered');

  const deleteButton = modal.getByRole('button', {
    name: /^delete$/i
  }).last();

  await expect(deleteButton).toBeVisible({
    timeout: 10000
  });

  await expect(deleteButton).toBeEnabled();

  await deleteButton.click();

  console.log('[Delete] Final Delete button clicked');

  await expect(modal).toBeHidden({
    timeout: 20000
  });
}

// ========================================
// MAIN TEST
// ========================================



test('Delete collection area by code', async ({ page }) => {
  test.setTimeout(180000);
  page.setDefaultTimeout(15000);

  const areaCode = 'MCF-CO-AR-8';

  console.log('[Target Code]', areaCode);

  // STEP 1: Login
  await loginIfNeeded(page);

  // STEP 2: Close dashboard popup
  await closeClosingGroupsPopup(page);

  // STEP 3: Open Collection Area page
  await openCollectionArea(page);

  // STEP 4: Search using Collection Area Code
  const { row, areaName } = await findCollectionArea(
  page,
  'MCF-CO-AR-8'
);

  await expect(row).toHaveCount(1);

  console.log('[Found] Code:', areaCode);
  console.log('[Found] Area Name:', areaName);

  // Safety check before deleting the record
  const expectedName = (
    process.env.EXPECTED_DELETE_COLLECTION_AREA_NAME || ''
  ).trim();

  if (!expectedName || areaName !== expectedName) {
    throw new Error(
      `Deletion cancelled. Found "${areaName}". ` +
      'Set EXPECTED_DELETE_COLLECTION_AREA_NAME in .env ' +
      'to this exact name after verifying the record.'
    );
  }

  // STEP 5: Click the matching row's three dots
  // and select Delete
  console.log('[Action] Clicking three dots');
  await openActionMenu(row, page);

  // STEP 6: Enter the area name in the popup
  // and click the final Delete button
  console.log('[Delete] Confirming deletion');
  await confirmDeletion(page, areaName);

  // STEP 7: Verify deletion
  const main = page.locator('#app-main-scroll');

  const searchInput = main.locator(
    'input[placeholder^="Search" i]:visible'
  ).first();

  await searchInput.fill('');
  await searchInput.fill(areaCode);

  const matchingRows = main.locator(
    'table tbody tr'
  ).filter({
    has: page.locator('td:nth-child(2)').getByText(
      areaCode,
      { exact: true }
    )
  });

  await expect(matchingRows).toHaveCount(0, {
    timeout: 20000
  });

  console.log(
    '[Completed] Collection Area deleted:',
    areaCode,
    '| Name:',
    areaName
  );
});

